# Salin ke .env lalu isi. JANGAN commit .env yang berisi password/secret asli.

# Koneksi MySQL/MariaDB untuk Prisma (ganti user, password, dan nama database)
DATABASE_URL="mysql://root:@localhost:3306/gilakomputer_db"

# Kunci penanda tangan sesi login (WAJIB, minimal 32 karakter acak).
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mengganti nilai ini akan mengeluarkan semua pengguna dari sesi login.
AUTH_SECRET=

# Opsional: dipakai `npm run db:create-admin` agar tidak perlu mengetik di terminal.
# Hapus dari .env setelah akun admin dibuat.
# ADMIN_NAME=Admin Toko
# ADMIN_EMAIL=admin@contoh.com
# ADMIN_PASSWORD=
